---
import ThemeInit from './ThemeInit.astro';
import TerminalCursor from './TerminalCursor.astro';
import ThemeToggle from './ThemeToggle.astro';
import Logo from './Logo.astro';
import SeoHead from './SeoHead.astro';
import LanguageSwitch from './LanguageSwitch.astro';
import LanguageRedirect from './LanguageRedirect.astro';
import StackBoard from './StackBoard.astro';
import CareerLog from './CareerLog.astro';
import SocialLinks from './SocialLinks.astro';
import HeroPortrait from './HeroPortrait.astro';
import LocalClock from './LocalClock.astro';
import '../styles/global.css';
import { projects } from '../data/projects';
import { homeCopy } from '../data/home';
import { budgetLabel, budgetSteps, currencies } from '../data/budget';
import { homePath, homeStructuredData, projectPath, type Lang } from '../data/site';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = homeCopy[lang];
const alternates = { en: homePath('en'), es: homePath('es') };
const brief = t.brief;
const chipOptions = (group: { options: Record<string, string> }) => Object.entries(group.options);
const structuredData = homeStructuredData(Astro.site!, lang, { description: t.metaDescription, services: t.services });

// Falls back to Cloudflare's always-pass test key for local dev.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';
---

<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		{lang === 'en' && <LanguageRedirect to={alternates.es} />}
		<ThemeInit />
		<SeoHead title={t.pageTitle} description={t.metaDescription} lang={lang} alternates={alternates} imageAlt={t.ogImageAlt} structuredData={structuredData} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
	</head>
	<body>
		<header class="site-header">
			<a class="wordmark" href="#top" aria-label="Javier Cazares, back to top"><Logo size={34} /></a>
			<div class="header-prompt"><span class="prompt-symbol">›</span> javier@dev-environment:~$</div>
		<nav aria-label={t.navLabel}>
				<a href="#services">{t.navServices}</a>
				<a href="#work">{t.navWork}</a>
				<a href="#stack">{t.navStack}</a>
				<a href="#career">{t.navCareer}</a>
				<a href="#contact">{t.navContact}</a>
				<ThemeToggle />
				<LanguageSwitch lang={lang} alternates={alternates} />
			</nav>
		</header>

		<main id="top">
			<section class="hero shell" aria-labelledby="hero-title">
				<div class="hero-kicker"><span class="status-dot"></span> <span>{t.heroKicker}</span> <span class="kicker-separator">/</span> {t.heroLocation}</div>
				<div class="hero-copy">
					<p class="command-line"><span>&gt;</span> <span>{t.heroCommand}</span></p>
					<h1 id="hero-title"><span>{t.heroLine1}</span><br /><span set:html={t.heroLine2} /><br /><span>{t.heroLine3}</span><span class="cursor">_</span></h1>
					<div class="hero-foot">
						<p>{t.heroIntro}</p>
						<a class="text-link" href="#services"><span>{t.heroLink}</span> <span aria-hidden="true">↘</span></a>
					</div>
					<SocialLinks />
				</div>
				<div class="hero-aside">
					<HeroPortrait />
					<div aria-hidden="true">
						<div class="aside-label">{t.currentMode}</div>
						<div class="mode-line"><span class="mode-square"></span> <span>{t.makingThings}</span></div>
						<div class="aside-rule"></div>
						<LocalClock lang={lang} />
					</div>
				</div>
				<div class="hero-index" aria-hidden="true">PORTFOLIO / 2026</div>
			</section>

			<section class="services-section shell" id="services" aria-labelledby="services-title">
				<div class="section-heading compact-heading">
					<div><span class="section-index">{t.servicesIndex}</span><h2 id="services-title">{t.servicesTitle}<span class="heading-period">.</span></h2></div>
					<p>{t.servicesIntro}</p>
				</div>
				<div class="services-board">
					<div class="panel-bar" aria-hidden="true"><span>$ ls ~/services</span><span>{t.services.length}</span></div>
					<ul class="service-grid">
						{t.services.map((service, index) => (
							<li class="service-item">
								<span class="service-command" aria-hidden="true"><b>{String(index + 1).padStart(2, '0')}</b> {service.command}</span>
								<h3>{service.title}</h3>
								<p>{service.body}</p>
							</li>
						))}
					</ul>
					<div class="services-foot">
						<p><span class="prompt-symbol">›</span>{t.servicesArea}</p>
						<a class="text-link" href="#contact">[ {t.servicesCta} <span aria-hidden="true">↗</span> ]</a>
					</div>
				</div>
			</section>

			<section class="work-section shell" id="work" aria-labelledby="work-title">
				<div class="section-heading">
					<div><span class="section-index">{t.workIndex}</span><h2 id="work-title">{t.workTitle}<span class="heading-period">.</span></h2></div>
					<p>{t.workIntro}</p>
				</div>
				<div class="project-grid">
					{projects.map((project) => (
						<article class="project-card">
							<div class="window-bar" aria-hidden="true">
								<span class="window-title"><span class="window-glyph"></span>~/work/{project.slug}</span>
								<span class="window-controls"><i>_</i><i>□</i><i>×</i></span>
							</div>
							<div class={`project-art ${project.cardArt.theme}`} aria-label={`${project.name[lang]} visual`} role="img">
								<div class="art-topline"><span>J/C—{project.number}</span><span>{project.type[lang]}</span></div>
								<div class="atlas-art"><div class="atlas-label">{project.cardArt.label[0]}<br />{project.cardArt.label[1]}<span>.</span></div>{project.cardImage ? <img class="atlas-shot" src={project.cardImage} alt="" width="1200" height="792" loading="lazy" decoding="async" /> : <div class="atlas-grid"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>}<div class="atlas-tag">{project.type[lang]}<br />{project.cardArt.tag[lang]} ↗</div></div>
								<span class="art-corner" aria-hidden="true">↗</span>
							</div>
							<div class="project-info">
								<div class="project-title-row"><span class="project-type">{project.type[lang]}</span></div>
								<h3>{project.name[lang]}</h3>
								<p>{project.cardDescription[lang]}</p>
								<div class="project-stack">[ {project.stack.join(' · ')} ]</div>
								<a class="project-read-link" href={projectPath(lang, project.slug)}><span>{t.readProject}</span> <span aria-hidden="true">↗</span></a>
							</div>
							<div class="window-status" aria-hidden="true">
								<span>{project.stack.length} MODULES · {project.cardImage ? '1200×792' : '—'}</span>
							</div>
						</article>
					))}
				</div>
				<p class="work-note"><span>*</span> <span>{t.workNote}</span></p>
			</section>

			<section class="stack-section shell" id="stack" aria-labelledby="stack-title">
				<div class="section-heading compact-heading">
					<div><span class="section-index">{t.stackIndex}</span><h2 id="stack-title">{t.stackTitle}<span class="heading-period">.</span></h2></div>
					<p>{t.stackIntro}</p>
				</div>
				<StackBoard lang={lang} />
			</section>

			<section class="career-section shell" id="career" aria-labelledby="career-title">
				<div class="section-heading compact-heading">
					<div><span class="section-index">{t.careerIndex}</span><h2 id="career-title">{t.careerTitle}<span class="heading-period">.</span></h2></div>
					<p>{t.careerIntro}</p>
				</div>
				<CareerLog lang={lang} />
			</section>
			<section class="contact-section shell" id="contact" aria-labelledby="contact-title">
				<div class="contact-top"><span class="section-index">{t.contactIndex}</span><span class="contact-status"><span class="status-dot"></span> <span>{t.contactStatus}</span></span></div>
				<div class="contact-content">
					<div><p class="command-line"><span>&gt;</span> <span>{t.contactCommand}</span></p><h2 id="contact-title"><span set:html={t.contactTitle} /><span class="highlight">?</span><span class="cursor">_</span></h2><p class="contact-copy" set:html={t.contactCopy} />
						<details class="terms">
							<summary class="panel-bar"><span>$ {t.terms.command}</span><span class="terms-toggle">[ <span class="terms-sign" aria-hidden="true"></span> ]</span></summary>
							<dl class="terms-list">
								{t.terms.items.map((item) => (
									<div class="terms-row">
										<dt>{item.key}</dt>
										<dd>
											{item.body}
											{item.milestones && (
												<ol class="milestones">
													{item.milestones.map((step) => <li style={`flex-grow: ${step.pct}`}><b>{step.pct}%</b><span>{step.label}</span></li>)}
												</ol>
											)}
										</dd>
									</div>
								))}
							</dl>
						</details>
					</div>
					<form id="idea-form" class="idea-form" data-messages={JSON.stringify(t.formMessages)}>
						<label for="idea" set:html={t.ideaLabel} />
						<textarea id="idea" name="idea" rows="4" maxlength="5000" placeholder={t.ideaPlaceholder} required></textarea>
						<label for="idea-email" class="email-label" set:html={t.emailLabel} />
						<input id="idea-email" name="email" type="email" autocomplete="email" placeholder="you@domain.com" required />
						<details class="brief">
							<summary>[ <span class="brief-sign" aria-hidden="true"></span> {brief.toggle} <span class="brief-optional">{brief.optional}</span> ]</summary>
							<p class="brief-intro">{brief.intro}</p>
							<div class="brief-row">
								<label for="brief-company" class="brief-key">{brief.company.label}</label>
								<input id="brief-company" name="company" type="text" maxlength="500" autocomplete="organization" placeholder={brief.company.placeholder} />
							</div>
							<fieldset class="brief-row">
								<legend class="brief-key">{brief.budget.label} <span class="brief-hint"># {brief.budget.hint}</span></legend>
								<div class="budget" data-unset={brief.budget.unset}>
									<div class="budget-head">
										<output id="budget-readout" class="budget-readout" for="brief-budget">{brief.budget.unset}</output>
										<div class="chips">{currencies.map((currency) => <label class="chip"><input type="radio" name="currency" value={currency} checked={currency === brief.budget.currency} /><span>{currency.toUpperCase()}</span></label>)}</div>
									</div>
									<input id="brief-budget" class="budget-range" name="budget" type="range" min="0" max={budgetSteps - 1} step="1" value={Math.floor(budgetSteps / 2)} aria-label={brief.budget.label} aria-valuetext={brief.budget.unset} />
									<div class="budget-scale" aria-hidden="true"><span>{budgetLabel(0, brief.budget.currency)}</span><span>{budgetLabel(budgetSteps - 1, brief.budget.currency)}</span></div>
								</div>
							</fieldset>
							<fieldset class="brief-row">
								<legend class="brief-key">{brief.timeline.label}</legend>
								<div class="chips">{chipOptions(brief.timeline).map(([value, label]) => <label class="chip"><input type="radio" name="timeline" value={value} /><span>{label}</span></label>)}</div>
								<input name="deadline" type="text" maxlength="500" aria-label={brief.timeline.placeholder} placeholder={brief.timeline.placeholder} />
							</fieldset>
							<div class="brief-row">
								<label for="brief-users" class="brief-key">{brief.users.label}</label>
								<input id="brief-users" name="users" type="text" maxlength="500" placeholder={brief.users.placeholder} />
							</div>
							<div class="brief-row">
								<label for="brief-current" class="brief-key">{brief.current.label}</label>
								<input id="brief-current" name="current" type="text" maxlength="500" placeholder={brief.current.placeholder} />
							</div>
							<div class="brief-row">
								<label for="brief-integrations" class="brief-key">{brief.integrations.label}</label>
								<input id="brief-integrations" name="integrations" type="text" maxlength="500" placeholder={brief.integrations.placeholder} />
							</div>
							<div class="brief-row">
								<label for="brief-mvp" class="brief-key">{brief.mvp.label}</label>
								<textarea id="brief-mvp" name="mvp" rows="3" maxlength="2000" placeholder={brief.mvp.placeholder}></textarea>
							</div>
							{(['devices', 'access', 'infra'] as const).map((name) => (
								<fieldset class="brief-row">
									<legend class="brief-key">{brief[name].label} <span class="brief-hint"># {brief[name].hint}</span></legend>
									<div class="chips">{chipOptions(brief[name]).map(([value, label]) => <label class="chip"><input type={name === 'devices' ? 'checkbox' : 'radio'} name={name} value={value} /><span>{label}</span></label>)}</div>
								</fieldset>
							))}
						</details>
						<input class="honeypot" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
						<div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="auto" data-size="flexible" data-language={lang}></div>
						<div class="form-bottom"><span id="form-feedback" aria-live="polite">{t.formHelp}</span><button type="submit"><span>{t.sendNote}</span> <span aria-hidden="true">↗</span> ]</button></div>
					</form>
				</div>
			</section>
		</main>

		<footer class="site-footer shell"><a class="footer-mark" href="#top" aria-label="Javier Cazares, back to top"><Logo size={26} /></a><span set:html={t.footerMade} /><SocialLinks compact /><a href="#top" class="back-top">{t.backTop}</a><span class="copyright">© 2026 JAVIER CAZARES</span></footer>
		<script>
			import { budgetLabel, budgetSteps, isCurrency, type Currency } from '../data/budget';

			const form = document.querySelector<HTMLFormElement>('#idea-form');
			const field = document.querySelector<HTMLTextAreaElement>('#idea');
			const feedback = document.querySelector<HTMLElement>('#form-feedback');
			const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
			const messages: Record<string, string> = JSON.parse(form?.dataset.messages ?? '{}');
			const say = (key: string) => { if (feedback) feedback.textContent = messages[key] ?? ''; };

			// Budget range picker. The slider always has a value, so it only counts once the visitor touches it.
			const budgetBox = form?.querySelector<HTMLElement>('.budget');
			const budget = form?.querySelector<HTMLInputElement>('#brief-budget');
			const readout = form?.querySelector<HTMLOutputElement>('#budget-readout');
			const scale = budgetBox?.querySelectorAll<HTMLElement>('.budget-scale span');
			let budgetTouched = false;
			const currency = (): Currency => {
				const value = form?.querySelector<HTMLInputElement>('input[name="currency"]:checked')?.value ?? '';
				return isCurrency(value) ? value : 'usd';
			};
			const currentBudget = () => (budgetTouched && budget ? budgetLabel(Number(budget.value), currency()) : null);
			const renderBudget = () => {
				if (!budgetBox || !budget || !readout) return;
				const label = currentBudget() ?? budgetBox.dataset.unset ?? '';
				readout.textContent = label;
				budget.setAttribute('aria-valuetext', label);
				budgetBox.toggleAttribute('data-touched', budgetTouched);
				scale?.forEach((end, i) => { end.textContent = budgetLabel(i === 0 ? 0 : budgetSteps - 1, currency()); });
			};
			const touchBudget = () => { budgetTouched = true; renderBudget(); };
			budget?.addEventListener('input', touchBudget);
			budget?.addEventListener('pointerup', touchBudget);
			form?.addEventListener('change', (event) => { if ((event.target as HTMLInputElement).name === 'currency') renderBudget(); });
			// Native reset restores the inputs after this event fires, so re-render on the next tick.
			form?.addEventListener('reset', () => { budgetTouched = false; setTimeout(renderBudget); });

			const payload = () => {
				const data = new FormData(form ?? undefined);
				if (!budgetTouched) { data.delete('budget'); data.delete('currency'); }
				return data;
			};
			const hidden = new Set(['website', 'cf-turnstile-response', 'currency']);
			// Plain-text copy of every filled field, used when the send fails.
			const summarize = (data: FormData) => [...data.entries()]
				.filter(([key, value]) => !hidden.has(key) && String(value).trim())
				.map(([key, value]) => `${key}: ${key === 'budget' ? currentBudget() : String(value).trim()}`)
				.join('\n');
			form?.addEventListener('submit', async (event) => {
				event.preventDefault();
				if (!field?.value.trim() || !feedback || !submitButton) return;
				submitButton.disabled = true;
				say('sending');
				try {
					const response = await fetch('/api/contact', { method: 'POST', body: payload() });
					const result = await response.json().catch(() => ({ ok: false }));
					if (result.ok) {
						form.reset();
						form.querySelector('details')?.removeAttribute('open');
						say('sent');
					} else if (result.error === 'captcha' || result.error === 'invalid_email') {
						say(result.error === 'captcha' ? 'captcha' : 'email');
					} else {
						throw new Error(result.error);
					}
				} catch {
					await navigator.clipboard.writeText(summarize(payload())).catch(() => field.select());
					say('failed');
				} finally {
					window.turnstile?.reset();
					submitButton.disabled = false;
				}
			});
		</script>
		<TerminalCursor />
	</body>
</html>
