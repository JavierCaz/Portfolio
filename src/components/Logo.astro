---
/** The jc mark: the j's dot is the terminal cursor, blinking in a notch cut from the tile's frame. Inline so it follows the active theme. Standalone copies live in public/brand/. */
interface Props {
	size?: number;
}

const { size = 32 } = Astro.props;
---

<svg class="logo-mark" width={size} height={size} viewBox="0 0 64 64" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
	<rect class="logo-shadow" x="8" y="8" width="54" height="54" />
	<!-- Open path: the fill still closes the square, the stroke leaves a gap for the cursor. -->
	<path class="logo-tile" d="M29 3H55V55H3V3H17" stroke-width="2" />
	<g class="logo-glyphs">
		<rect x="14" y="12" width="12" height="6" />
		<rect x="20" y="12" width="6" height="36" />
		<rect x="8" y="42" width="18" height="6" />
		<rect x="32" y="12" width="18" height="6" />
		<rect x="32" y="12" width="6" height="24" />
		<rect x="32" y="30" width="18" height="6" />
	</g>
	<rect class="logo-cursor cursor" x="20" y="0" width="6" height="6" />
</svg>
