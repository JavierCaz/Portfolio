---
/**
 * The jc mark: a terminal block cursor with the initials knocked out, the way a cursor inverts the character under it.
 * Drawn on a 16×16 grid, so render it at multiples of 16px (or 24px, which is whole pixels at 2×) to keep edges crisp.
 * Inline so it follows the active theme. Standalone copies live in public/brand/ and public/favicon.svg.
 */
interface Props {
	size?: number;
}

const { size = 32 } = Astro.props;
---

<svg class="logo-mark" width={size} height={size} viewBox="0 0 16 16" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
	<rect class="logo-tile" width="16" height="16" />
	<g class="logo-glyphs">
		<!-- j -->
		<rect x="5" y="2" width="2" height="2" />
		<rect x="3" y="5" width="2" height="2" />
		<rect x="5" y="5" width="2" height="8" />
		<rect x="3" y="12" width="2" height="2" />
		<rect x="5" y="13" width="1" height="1" />
		<!-- c -->
		<rect x="9" y="5" width="4" height="2" />
		<rect x="8" y="6" width="2" height="4" />
		<rect x="9" y="9" width="4" height="2" />
	</g>
</svg>
