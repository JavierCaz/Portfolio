---
import ThemeInit from '../components/ThemeInit.astro';
import TerminalCursor from '../components/TerminalCursor.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import Logo from '../components/Logo.astro';
import BrandHead from '../components/BrandHead.astro';
import StackBoard from '../components/StackBoard.astro';
import CareerLog from '../components/CareerLog.astro';
import Localized from '../components/Localized.astro';
import SocialLinks from '../components/SocialLinks.astro';
import HeroPortrait from '../components/HeroPortrait.astro';
import '../styles/global.css';
import { projects } from '../data/projects';

// Falls back to Cloudflare's always-pass test key for local dev.
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';

---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<ThemeInit />
		<meta name="description" content="Javier Cazares — a corner of the internet for things made with care." data-i18n="metaDescription" />
		<BrandHead title="Javier Cazares — Maker's Terminal" description="Javier Cazares — a corner of the internet for things made with care." />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
		<title data-i18n="pageTitle">Javier Cazares — Maker's Terminal</title>
	</head>
	<body>
		<header class="site-header">
			<a class="wordmark" href="#top" aria-label="Javier Cazares, back to top"><Logo size={34} /></a>
			<div class="header-prompt"><span class="prompt-symbol">›</span> javier@dev-environment:~$</div>
		<nav aria-label="Main navigation">
				<a href="#work" data-i18n="navWork">[ WORK ]</a>
				<a href="#stack" data-i18n="navStack">[ STACK ]</a>
				<a href="#career" data-i18n="navCareer">[ LOG ]</a>
				<a href="#contact" data-i18n="navContact">[ CONTACT ]</a>
				<ThemeToggle />
				<div class="language-switch" role="group" aria-label="Choose language">
					<button type="button" data-language="en" aria-pressed="true">EN</button>
					<span aria-hidden="true">/</span>
					<button type="button" data-language="es" aria-pressed="false">ES</button>
				</div>
			</nav>
		</header>

		<main id="top">
			<section class="hero shell" aria-labelledby="hero-title">
				<div class="hero-kicker"><span class="status-dot"></span> <span data-i18n="heroKicker">INDEPENDENT DEVELOPER</span> <span class="kicker-separator">/</span> CHIHUAHUA, MX</div>
				<div class="hero-copy">
					<p class="command-line"><span>&gt;</span> <span data-i18n="heroCommand">cd ~/the-good-stuff</span></p>
					<h1 id="hero-title"><span data-i18n="heroLine1">A space for</span><br /><span data-i18n="heroLine2">things <span class="highlight">made</span></span><br /><span data-i18n="heroLine3">with purpose</span><span class="cursor">_</span></h1>
					<div class="hero-foot">
						<p data-i18n="heroIntro">Hi, I’m Javier. I build useful software, follow interesting ideas, and share the things I learn along the way.</p>
						<a class="text-link" href="#work"><span data-i18n="heroLink">TAKE A LOOK AROUND</span> <span aria-hidden="true">↘</span></a>
					</div>
				</div>
				<div class="hero-aside">
					<HeroPortrait />
					<div aria-hidden="true">
						<div class="aside-label" data-i18n="currentMode">CURRENT MODE</div>
						<div class="mode-line"><span class="mode-square"></span> <span data-i18n="makingThings">MAKING THINGS</span></div>
						<div class="aside-rule"></div>
						<div class="aside-label">BUILD / BREAK / LEARN</div>
						<div class="aside-mark">[ 01—∞ ]</div>
					</div>
				</div>
				<div class="hero-index" aria-hidden="true">PORTFOLIO / 2026</div>
			</section>

			<section class="work-section shell" id="work" aria-labelledby="work-title">
				<div class="section-heading">
					<div><span class="section-index" data-i18n="workIndex">01 / SELECTED WORK</span><h2 id="work-title"><span data-i18n="workTitle">Things I’ve made</span><span class="heading-period">.</span></h2></div>
					<p data-i18n="workIntro">A few projects, experiments, and ideas that made it out of the notebook.</p>
				</div>
				<div class="project-grid">
					{projects.map((project) => (
						<article class="project-card">
							<div class={`project-art ${project.cardArt.theme}`} aria-label={`${project.name.en} visual`} role="img">
								<div class="art-topline"><span>J/C—{project.number}</span><Localized text={project.type} /></div>
								<div class="atlas-art"><div class="atlas-label">{project.cardArt.label[0]}<br />{project.cardArt.label[1]}<span>.</span></div>{project.cardImage ? <img class="atlas-shot" src={project.cardImage} alt="" width="1200" height="792" loading="lazy" decoding="async" /> : <div class="atlas-grid"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>}<div class="atlas-tag"><Localized text={project.type} /><br /><Localized text={project.cardArt.tag} /> ↗</div></div>
								<span class="art-corner" aria-hidden="true">↗</span>
							</div>
							<div class="project-info">
								<div class="project-title-row"><span class="project-number"><span data-locale="en">PROJECT_{project.number}</span><span data-locale="es" hidden>PROYECTO_{project.number}</span></span><span class="project-type"><Localized text={project.type} /></span></div>
								<h3><Localized text={project.name} /></h3>
								<p><Localized text={project.cardDescription} /></p>
								<div class="project-stack">[ {project.stack.join(' · ')} ]</div>
								<a class="project-read-link" href={`/projects/${project.slug}/`}><span data-i18n="readProject">READ PROJECT NOTE</span> <span aria-hidden="true">↗</span></a>
							</div>
						</article>
					))}
				</div>
				<p class="work-note"><span>*</span> <span data-i18n="workNote">A living collection. More in progress, always.</span></p>
			</section>

			<section class="stack-section shell" id="stack" aria-labelledby="stack-title">
				<div class="section-heading compact-heading">
					<div><span class="section-index" data-i18n="stackIndex">02 / THE STACK</span><h2 id="stack-title"><span data-i18n="stackTitle">What I build with</span><span class="heading-period">.</span></h2></div>
					<p data-i18n="stackIntro">Curiosity is part of the toolkit.</p>
				</div>
				<StackBoard />
			</section>

			<section class="career-section shell" id="career" aria-labelledby="career-title">
				<div class="section-heading compact-heading">
					<div><span class="section-index" data-i18n="careerIndex">03 / THE LOG</span><h2 id="career-title"><span data-i18n="careerTitle">How I got here</span><span class="heading-period">.</span></h2></div>
					<p data-i18n="careerIntro">A career, read like a git log. Pick a commit.</p>
				</div>
				<CareerLog />
			</section>
			<section class="contact-section shell" id="contact" aria-labelledby="contact-title">
				<div class="contact-top"><span class="section-index" data-i18n="contactIndex">04 / YOUR TURN</span><span class="contact-status"><span class="status-dot"></span> <span data-i18n="contactStatus">OPEN TO GOOD IDEAS</span></span></div>
				<div class="contact-content">
					<div><p class="command-line"><span>&gt;</span> <span data-i18n="contactCommand">./say-hello</span></p><h2 id="contact-title"><span data-i18n="contactTitle">Got a good<br />one</span><span class="highlight">?</span><span class="cursor">_</span></h2><p class="contact-copy" data-i18n="contactCopy">A project, a question, a half-formed thought. I’m listening.</p><SocialLinks /></div>
					<form id="idea-form" class="idea-form">
						<label for="idea" data-i18n="ideaLabel">&gt; SYSTEM READY. DROP YOUR IDEA BELOW:</label>
						<textarea id="idea" name="idea" rows="4" maxlength="5000" data-i18n-placeholder="ideaPlaceholder" placeholder="I’ve been thinking about..." required></textarea>
						<label for="idea-email" class="email-label" data-i18n="emailLabel">&gt; REPLY TO (OPTIONAL):</label>
						<input id="idea-email" name="email" type="email" autocomplete="email" placeholder="you@domain.com" />
						<input class="honeypot" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
						<div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="auto" data-size="flexible"></div>
						<div class="form-bottom"><span id="form-feedback" aria-live="polite" data-i18n="formHelp">GOES STRAIGHT TO MY INBOX.</span><button type="submit"><span data-i18n="sendNote">[ EXECUTE SEND</span> <span aria-hidden="true">↗</span> ]</button></div>
					</form>
				</div>
			</section>
		</main>

		<footer class="site-footer shell"><a class="footer-mark" href="#top" aria-label="Javier Cazares, back to top"><Logo size={26} /></a><span data-i18n="footerMade">MADE WITH INTENTION &amp; A LOT OF COFFEE.</span><SocialLinks compact /><a href="#top" class="back-top" data-i18n="backTop">BACK TO TOP ↑</a><span class="copyright">© 2026 JAVIER CAZARES</span></footer>
		<script>
			const translations = {
				en: {
					pageTitle: "Javier Cazares — Maker's Terminal", metaDescription: 'Javier Cazares — a corner of the internet for things made with care.',
					navWork: '[ WORK ]', navStack: '[ STACK ]', navCareer: '[ LOG ]', navContact: '[ CONTACT ]', heroKicker: 'INDEPENDENT DEVELOPER', heroCommand: 'cd ~/the-good-stuff', readProject: 'READ PROJECT NOTE',
					heroLine1: 'A space for', heroLine2: 'things <span class="highlight">made</span>', heroLine3: 'with purpose',
					heroIntro: 'Hi, I’m Javier. I build useful software, follow interesting ideas, and share the things I learn along the way.', heroLink: 'TAKE A LOOK AROUND',
					currentMode: 'CURRENT MODE', makingThings: 'MAKING THINGS', workIndex: '01 / SELECTED WORK', workTitle: 'Things I’ve made',
					workIntro: 'A few projects, experiments, and ideas that made it out of the notebook.', workNote: 'A living collection. More in progress, always.',
					stackIndex: '02 / THE STACK', stackTitle: 'What I build with', stackIntro: 'Curiosity is part of the toolkit.', readOnly: 'READ ONLY', alwaysLearning: 'ALWAYS LEARNING',
					careerIndex: '03 / THE LOG', careerTitle: 'How I got here', careerIntro: 'A career, read like a git log. Pick a commit.',
					contactIndex: '04 / YOUR TURN', contactStatus: 'OPEN TO GOOD IDEAS', contactCommand: './say-hello', contactTitle: 'Got a good<br />one',
					contactCopy: 'A project, a question, a half-formed thought.<br />I’m listening.', ideaLabel: '&gt; SYSTEM READY. DROP YOUR IDEA BELOW:',
					ideaPlaceholder: 'I’ve been thinking about...', formHelp: 'GOES STRAIGHT TO MY INBOX.', sendNote: '[ EXECUTE SEND', emailLabel: '&gt; REPLY TO (OPTIONAL):',
					footerMade: 'MADE WITH INTENTION &amp; A LOT OF COFFEE.', backTop: 'BACK TO TOP ↑',
					sending: 'TRANSMITTING...', sent: 'RECEIVED. I’LL GET BACK TO YOU.', captcha: 'VERIFICATION PENDING. TRY AGAIN IN A SECOND.', failed: 'SEND FAILED. YOUR NOTE WAS COPIED — EMAIL IT TO ME.'
				},
				es: {
					pageTitle: 'Javier Cazares — Terminal del creador', metaDescription: 'Javier Cazares — un rincón de internet para compartir cosas hechas con intención.',
					navWork: '[ PROYECTOS ]', navStack: '[ STACK ]', navCareer: '[ LOG ]', navContact: '[ CONTACTO ]', heroKicker: 'DESARROLLADOR INDEPENDIENTE', heroCommand: 'cd ~/buenas-ideas', readProject: 'LEER SOBRE EL PROYECTO',
					heroLine1: 'Un espacio para', heroLine2: 'cosas <span class="highlight">hechas</span>', heroLine3: 'con propósito',
					heroIntro: 'Hola, soy Javier. Creo software útil, sigo ideas interesantes y comparto lo que voy aprendiendo.', heroLink: 'ECHA UN VISTAZO',
					currentMode: 'MODO ACTUAL', makingThings: 'CREANDO COSAS', workIndex: '01 / PROYECTOS', workTitle: 'Cosas que he creado',
					workIntro: 'Proyectos, experimentos e ideas que salieron del cuaderno.', workNote: 'Una colección viva. Siempre hay algo más en camino.',
					stackIndex: '02 / EL STACK', stackTitle: 'Con qué construyo', stackIntro: 'La curiosidad también es parte del oficio.', readOnly: 'SOLO LECTURA', alwaysLearning: 'SIEMPRE APRENDIENDO',
					careerIndex: '03 / EL LOG', careerTitle: 'Cómo llegué aquí', careerIntro: 'Una trayectoria, leída como un git log. Elige un commit.',
					contactIndex: '04 / TU TURNO', contactStatus: 'ABIERTO A BUENAS IDEAS', contactCommand: './di-hola', contactTitle: '¿Tienes una<br />buena idea',
					contactCopy: 'Un proyecto, una pregunta, una idea a medio formar.<br />Te leo.', ideaLabel: '&gt; SISTEMA LISTO. CUÉNTAME TU IDEA:',
					ideaPlaceholder: 'He estado pensando en...', formHelp: 'LLEGA DIRECTO A MI BANDEJA.', sendNote: '[ EJECUTAR ENVÍO', emailLabel: '&gt; RESPONDER A (OPCIONAL):',
					footerMade: 'HECHO CON INTENCIÓN Y MUCHO CAFÉ.', backTop: 'VOLVER ARRIBA ↑',
					sending: 'TRANSMITIENDO...', sent: 'RECIBIDO. TE RESPONDO PRONTO.', captcha: 'VERIFICACIÓN PENDIENTE. INTENTA DE NUEVO EN UN SEGUNDO.', failed: 'FALLÓ EL ENVÍO. TU MENSAJE SE COPIÓ — ENVÍAMELO POR CORREO.'
				}
			};
			const applyLanguage = (language, persist = false) => {
				const copy = translations[language] || translations.en;
				document.documentElement.lang = language;
					document.querySelectorAll('[data-i18n]').forEach((element) => {
					const value = copy[element.dataset.i18n];
					if (!value) return;
					if (element instanceof HTMLMetaElement) element.content = value;
					else element.innerHTML = value;
				});
				document.querySelectorAll('[data-i18n-placeholder]').forEach((element) => {
					const value = copy[element.dataset.i18nPlaceholder];
					if (value) element.setAttribute('placeholder', value);
				});
				document.querySelectorAll('[data-locale]').forEach((node) => { node.hidden = node.dataset.locale !== language; });
				document.querySelectorAll('[data-language]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.language === language)));
				if (persist) localStorage.setItem('portfolio-language', language);
				window.currentPortfolioLanguage = language;
			};
			const savedLanguage = localStorage.getItem('portfolio-language');
			const primaryBrowserLanguage = (navigator.languages && navigator.languages[0]) || navigator.language || 'en';
			const browserLanguage = /^es(-|$)/i.test(primaryBrowserLanguage) ? 'es' : 'en';
			applyLanguage(savedLanguage === 'es' || savedLanguage === 'en' ? savedLanguage : browserLanguage);
			document.querySelectorAll('[data-language]').forEach((button) => button.addEventListener('click', () => applyLanguage(button.dataset.language, true)));

			const form = document.querySelector<HTMLFormElement>('#idea-form');
			const field = document.querySelector<HTMLTextAreaElement>('#idea');
			const feedback = document.querySelector<HTMLElement>('#form-feedback');
			const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
			const say = (key) => { if (feedback) feedback.textContent = translations[window.currentPortfolioLanguage]?.[key] || translations.en[key]; };
			form?.addEventListener('submit', async (event) => {
				event.preventDefault();
				if (!field?.value.trim() || !feedback || !submitButton) return;
				submitButton.disabled = true;
				say('sending');
				try {
					const response = await fetch('/api/contact', { method: 'POST', body: new FormData(form) });
					const result = await response.json().catch(() => ({ ok: false }));
					if (result.ok) {
						form.reset();
						say('sent');
					} else if (result.error === 'captcha') {
						say('captcha');
					} else {
						throw new Error(result.error);
					}
				} catch {
					await navigator.clipboard.writeText(field.value.trim()).catch(() => field.select());
					say('failed');
				} finally {
					window.turnstile?.reset();
					submitButton.disabled = false;
				}
			});
		</script>
		<TerminalCursor />
	</body>
</html>
